<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SlidingNumbersPlus.Views.HomePage"
             NavigationPage.HasNavigationBar="False">
  <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,70">

    <Image x:Name="imgBg" Grid.RowSpan="6" Aspect="AspectFill"
           Opacity="0.22" HorizontalOptions="Fill" VerticalOptions="Fill"/>

    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End"
                           VerticalOptions="End" Margin="0,0,24,12" Spacing="6">
      <Label Text="&#x2B50;" FontSize="22" VerticalOptions="Center"/>
      <Label x:Name="lblStars" FontSize="22" FontAttributes="Bold"
             TextColor="#FFD700" VerticalOptions="Center"/>
    </HorizontalStackLayout>

    <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="2" Margin="0,0,0,10">
      <Label Text="SLIDING" FontSize="44" FontAttributes="Bold"
             TextColor="White" HorizontalTextAlignment="Center" CharacterSpacing="8"/>
      <Label Text="NUMBERS" FontSize="44" FontAttributes="Bold"
             TextColor="#E94560" HorizontalTextAlignment="Center" CharacterSpacing="8"/>
      <Label x:Name="lblSub" FontSize="13" TextColor="#AAAACC"
             HorizontalTextAlignment="Center" CharacterSpacing="3" Margin="0,8,0,0"/>
    </VerticalStackLayout>

    <Border Grid.Row="2" Margin="40,8" BackgroundColor="#E94560"
            StrokeThickness="0" StrokeShape="RoundRectangle 28">
      <Button x:Name="btnPlay" FontSize="19" FontAttributes="Bold"
              TextColor="White" BackgroundColor="Transparent"
              Padding="0,18" Clicked="OnPlayClicked"/>
    </Border>

    <Border Grid.Row="3" Margin="40,6" BackgroundColor="Transparent"
            Stroke="#E94560" StrokeThickness="2" StrokeShape="RoundRectangle 28">
      <Button Text="&#x1F3C6;  ALL LEVELS" FontSize="17" FontAttributes="Bold"
              TextColor="#E94560" BackgroundColor="Transparent"
              Padding="0,16" Clicked="OnLevelsClicked"/>
    </Border>

    <Border Grid.Row="4" Margin="40,6" BackgroundColor="Transparent"
            Stroke="#444466" StrokeThickness="2" StrokeShape="RoundRectangle 28">
      <Button Text="&#x2699;  SETTINGS" FontSize="17" TextColor="#AAAACC"
              BackgroundColor="Transparent" Padding="0,16"
              Clicked="OnSettingsClicked"/>
    </Border>

    <Label Grid.Row="5" Text="Slide tiles  &#x2022;  Earn stars  &#x2022;  Unlock cities"
           FontSize="12" TextColor="#444466"
           HorizontalTextAlignment="Center" VerticalOptions="Center"/>
  </Grid>
</ContentPage>
