                        <Button Text="NEXT LEVEL →" BackgroundColor="#E94560" CornerRadius="22" Clicked="OnNextLevelClicked" Padding="20,10"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>-->

            <!-- Fail Overlay -->
            <!--<Grid x:Name="failOverlay" Grid.RowSpan="3" BackgroundColor="#CC1A1A2E" IsVisible="False">
                <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 24" Padding="28" VerticalOptions="Center" Margin="30">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="💀" FontSize="72" HorizontalTextAlignment="Center"/>
                        <Label Text="OUT OF MOVES" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                        <Button x:Name="btnBuyMoves" Text="Spend 5 Stars (+20 Moves)" BackgroundColor="Green" Clicked="OnBuyMovesClicked"/>
                        <Button Text="RETRY" BackgroundColor="#E94560" Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>-->

            <Border x:Name="victoryAnim" BackgroundColor="Gray"
            IsVisible="False"
               StrokeShape="RoundRectangle 20"
               Grid.Row="1"
               Grid.ColumnSpan="6"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="280"
               HeightRequest="400">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*">
                    <Label Text="WELL DONE!" FontSize="24" Grid.ColumnSpan="3" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    <skia:SKLottieView Source="trophy.json" Grid.Row="1" Grid.ColumnSpan="3"
                        x:Name="trophyAnimation"
                        RepeatCount="2"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill" />
                    <skia:SKLottieView
                        IsVisible="False"
                                    Grid.Row="2"
                                      Source="stars.json"
                                      x:Name="starsAnimation1"
                                      RepeatCount="2"
                                      VerticalOptions="Start"
                                      HorizontalOptions="Start"
                                      Grid.Column="0"/>
                    <skia:SKLottieView Source="stars.json" Grid.Row="2"
                                       IsVisible="False"
                                      x:Name="starsAnimation2"
                                      RepeatCount="2"
                                      VerticalOptions="Start"
                                      HorizontalOptions="Start"
                                      Grid.Column="1"/>
                    <skia:SKLottieView Source="stars.json" Grid.Row="2"
                                       IsVisible="False"
                                      x:Name="starsAnimation3"
                                      RepeatCount="2"
                                      VerticalOptions="Start"
                                      HorizontalOptions="Start"
                                      Grid.Column="2"/>
                    
                    <skia:SKLottieView Source="confetti.json" Grid.RowSpan="4" Grid.ColumnSpan="3"
          x:Name="confettiAnimation"
          RepeatCount="-1"/>

                    <Button Text="NEXT LEVEL →" Grid.Row="3" Grid.ColumnSpan="3" BackgroundColor="Green" CornerRadius="22" Clicked="OnNextLevelClicked" HeightRequest="50" Margin="50"/>
                </Grid>

            </Border>

            

            <Border x:Name="failureAnim" BackgroundColor="Gray"
            IsVisible="False"
               StrokeShape="RoundRectangle 20"
               Grid.Row="1"
               Grid.ColumnSpan="6"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="280"
               HeightRequest="400">
                <Grid RowDefinitions="4*,3*,*,2*,2*">
                    <skia:SKLottieView x:Name="failureLottieAnim"
Source="failure.json"
RepeatCount="0" 
IsAnimationEnabled="False"
HorizontalOptions="Center" />

                            <Label Text="💀" Grid.Row=" 1" FontSize="72" HorizontalTextAlignment="Center"/>
                            <Label Text="OUT OF MOVES" Grid.Row=" 2" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                    <Button x:Name="btnBuyMoves" HeightRequest="50" Margin="20" Grid.Row=" 3" Text="Spend 5 Stars (+20 Moves)" BackgroundColor="Green" Clicked="OnBuyMovesClicked"/>
                    <Button Text="RETRY" Grid.Row=" 4" HeightRequest="50" Margin="20" BackgroundColor="#E94560" Clicked="OnRetryClicked"/>
                </Grid>

            </Border>

            <Grid x:Name="loadingOverlay" Grid.RowSpan="3" BackgroundColor="#D01A1A2E" IsVisible="False">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <ActivityIndicator IsRunning="True" Color="#E94560" WidthRequest="52" HeightRequest="52"/>
                    <Label Text="Shuffling puzzle..." TextColor="White" FontSize="16"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
