<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SlidingNumbersPlus.Views.SettingsPage"
             NavigationPage.HasNavigationBar="False">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,48,12,12">
      <Button Grid.Column="0" Text="&#x2190;" FontSize="24" TextColor="White"
              BackgroundColor="Transparent" Clicked="OnBackClicked" Padding="4,0"/>
      <Label Grid.Column="1" Text="SETTINGS" FontSize="20" FontAttributes="Bold"
             TextColor="White" VerticalOptions="Center"
             HorizontalOptions="Center" CharacterSpacing="4"/>
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="20" Spacing="14">

        <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 16"
                StrokeThickness="0" Padding="20,14">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
              <Label Text="Sound Effects" FontSize="16" FontAttributes="Bold" TextColor="White"/>
              <Label Text="Tap and move sounds" FontSize="12" TextColor="#AAAACC"/>
            </VerticalStackLayout>
            <Switch x:Name="switchSound" Grid.Column="1" OnColor="#E94560"
                    ThumbColor="White" VerticalOptions="Center" Toggled="OnSoundToggled"/>
          </Grid>
        </Border>

        <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 16"
                StrokeThickness="0" Padding="20,14">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
              <Label Text="Background Music" FontSize="16" FontAttributes="Bold" TextColor="White"/>
              <Label Text="Ambient music while playing" FontSize="12" TextColor="#AAAACC"/>
            </VerticalStackLayout>
            <Switch x:Name="switchMusic" Grid.Column="1" OnColor="#E94560"
                    ThumbColor="White" VerticalOptions="Center" Toggled="OnMusicToggled"/>
          </Grid>
        </Border>

        <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 16"
                StrokeThickness="0" Padding="20,16">
          <VerticalStackLayout Spacing="8">
            <Label Text="How to Play" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Label FontSize="13" TextColor="#AAAACC"
                   Text="Tap any tile in the same row or column as the empty space to slide it. Arrange all tiles in order from 1 to N to win. Earn up to 3 stars based on moves remaining."/>
            <Grid ColumnDefinitions="*,*,*" Margin="0,8,0,0" ColumnSpacing="8">
              <Border Grid.Column="0" BackgroundColor="#0F3460" StrokeShape="RoundRectangle 8"
                      StrokeThickness="0" Padding="6,6">
                <Label Text="&#x2B50;&#x2B50;&#x2B50;&#xA;Lots left" FontSize="11"
                       TextColor="#E94560" HorizontalTextAlignment="Center"/>
              </Border>
              <Border Grid.Column="1" BackgroundColor="#0F3460" StrokeShape="RoundRectangle 8"
                      StrokeThickness="0" Padding="6,6">
                <Label Text="&#x2B50;&#x2B50;&#xA;Some left" FontSize="11"
                       TextColor="White" HorizontalTextAlignment="Center"/>
              </Border>
              <Border Grid.Column="2" BackgroundColor="#0F3460" StrokeShape="RoundRectangle 8"
                      StrokeThickness="0" Padding="6,6">
                <Label Text="&#x2B50;&#xA;Just made it" FontSize="11"
                       TextColor="#AAAACC" HorizontalTextAlignment="Center"/>
              </Border>
            </Grid>
          </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 16"
                StrokeThickness="0" Padding="20,14">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
              <Label Text="Reset Progress" FontSize="16" FontAttributes="Bold" TextColor="#E94560"/>
              <Label Text="Clears all levels and stars" FontSize="12" TextColor="#AAAACC"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Reset" FontSize="13"
                    TextColor="#E94560" BackgroundColor="Transparent"
                    BorderColor="#E94560" BorderWidth="1"
                    CornerRadius="10" Padding="14,8" Clicked="OnResetClicked"/>
          </Grid>
        </Border>

        <Border BackgroundColor="#16213E" StrokeShape="RoundRectangle 16"
                StrokeThickness="0" Padding="20,16">
          <VerticalStackLayout Spacing="4">
            <Label Text="Sliding Numbers +" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Label Text="v1.0  &#x2022;  .NET 10 MAUI" FontSize="12" TextColor="#AAAACC"/>
            <Label Text="Classic sliding puzzle with city themes and star rewards."
                   FontSize="12" TextColor="#555577" Margin="0,4,0,0"/>
          </VerticalStackLayout>
        </Border>

      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
