<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SlidingNumbersPlus.Views.LevelsPage"
             NavigationPage.HasNavigationBar="False">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,48,12,12">
      <Button Grid.Column="0" Text="&#x2190;" FontSize="24" TextColor="White"
              BackgroundColor="Transparent" Clicked="OnBackClicked" Padding="4,0"/>
      <Label Grid.Column="1" Text="ALL LEVELS" FontSize="20" FontAttributes="Bold"
             TextColor="White" VerticalOptions="Center"
             HorizontalOptions="Center" CharacterSpacing="4"/>
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout x:Name="container" Spacing="20" Padding="16,0,16,40"/>
    </ScrollView>
  </Grid>
</ContentPage>
